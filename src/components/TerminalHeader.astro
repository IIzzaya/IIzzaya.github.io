---
/**
 * 终端风页头：`iizzaya@github:~/path$` + 闪烁光标（farhad.my 魔改）。
 * 路径部分随当前路由变化。
 */
import { NAV, SITE } from '../data/site';

const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const termPath = rawPath === '/' ? '~' : '~' + rawPath;

const isActive = (href: string) =>
  href === '/' ? rawPath === '/' : rawPath === href || rawPath.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-zinc-900 bg-zinc-950/75 backdrop-blur-[8px]">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-y-2 px-4 py-4 sm:px-6 xl:max-w-5xl xl:px-0">
    <!-- 终端提示符 -->
    <a href="/" class="group -ml-2 px-2 font-mono text-lg leading-none" aria-label="返回首页">
      <span class="text-zinc-400 transition-colors group-hover:text-zinc-200">{SITE.user}@github:</span><span
        class="text-terminal glow-text"
      >{termPath}$</span><span
        class="ml-1.5 inline-block h-4 w-[9px] translate-y-[3px] bg-terminal align-baseline animate-cursor-blink"
        aria-hidden="true"></span>
    </a>

    <!-- 导航 -->
    <nav class="flex items-center gap-1 pr-1 text-sm leading-5 sm:gap-2" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'group relative rounded-md px-2.5 py-1.5 font-medium transition-colors sm:px-3',
              isActive(item.href)
                ? 'text-terminal'
                : 'text-zinc-400 hover:text-zinc-100',
            ]}
          >
            {item.text}
            <span
              class:list={[
                'absolute inset-x-3 -bottom-0.5 h-[2px] rounded-full bg-terminal transition-all duration-200',
                isActive(item.href) ? 'opacity-100 glow-box' : 'opacity-0 group-hover:opacity-40',
              ]}
              aria-hidden="true"
            />
          </a>
        ))
      }
      <!-- Ctrl+K 面板触发按钮 -->
      <button
        id="palette-trigger"
        type="button"
        class="ml-1 hidden items-center gap-1.5 rounded-md border border-zinc-800 bg-zinc-900/60 px-2 py-1 font-mono text-xs text-zinc-400 transition-colors hover:border-zinc-600 hover:text-zinc-200 sm:flex"
        aria-label="打开快速导航 (Ctrl+K)"
        title="快速导航 (Ctrl+K)"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        Ctrl K
      </button>
    </nav>
  </div>
</header>

<script>
  document.getElementById('palette-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-palette'));
  });
</script>
