---
/** 背景漂浮发光技术栈图标。图标文件位于 public/static/tech-logos/<name>.svg */
import { FLOATING_ICONS } from '../data/site';

/**
 * 预设坐标与动画参数（百分比定位，桌面/移动端各自可见性），
 * 硬编码保证每次构建视觉一致。
 */
const LAYOUT = [
  { top: '12%', left: '6%',  size: 52, anim: 'animate-float-a', hide: 'hidden md:block' },
  { top: '26%', left: '88%', size: 64, anim: 'animate-float-b', hide: '' },
  { top: '52%', left: '4%',  size: 44, anim: 'animate-float-c', hide: 'hidden lg:block' },
  { top: '64%', left: '92%', size: 56, anim: 'animate-float-a', hide: 'hidden md:block' },
  { top: '82%', left: '12%', size: 40, anim: 'animate-float-b', hide: 'hidden lg:block' },
  { top: '8%',  left: '70%', size: 36, anim: 'animate-float-c', hide: '' },
  { top: '86%', left: '76%', size: 48, anim: 'animate-float-a', hide: 'hidden md:block' },
  { top: '40%', left: '15%', size: 32, anim: 'animate-float-b', hide: 'hidden xl:block' },
];
---

<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
  {
    FLOATING_ICONS.map((name, i) => {
      const p = LAYOUT[i % LAYOUT.length];
      return (
        <img
          src={`/static/tech-logos/${name}.svg`}
          alt=""
          width={p.size}
          height={p.size}
          class:list={['float-icon', p.anim, p.hide]}
          style={`top:${p.top};left:${p.left};width:${p.size}px;height:${p.size}px;animation-delay:-${(i * 3.7) % 12}s;`}
          loading="lazy"
        />
      );
    })
  }
</div>
