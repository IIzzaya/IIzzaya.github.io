---
/** 画廊项目卡片 */
interface Props {
  slug: string;
  name: string;
  tagline: string;
  description: string;
  tags: string[];
  accent: string;
  sourceUrl: string;
  /** 紧凑模式：主页横向滚动卡片（固定尺寸 + 截断长文案 + snap 对齐） */
  compact?: boolean;
  /** 播放按钮文案（默认「开始玩」） */
  playLabel?: string;
  /** 源码按钮文案（默认「源码」） */
  sourceLabel?: string;
}
const {
  slug,
  name,
  tagline,
  description,
  tags,
  accent,
  sourceUrl,
  compact = false,
  playLabel = '开始玩',
  sourceLabel = '源码',
} = Astro.props;
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/40 transition-all duration-300 hover:-translate-y-0.5 hover:border-zinc-600',
    compact && 'h-[380px] w-[300px] shrink-0 snap-start',
  ]}
  style={`--accent:${accent}`}
>
  <!-- 强调色顶部光线 -->
  <div
    class="h-[3px] w-full opacity-60 transition-opacity group-hover:opacity-100"
    style={`background:linear-gradient(90deg, transparent, ${accent}, transparent)`}
    aria-hidden="true"
  >
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-semibold text-zinc-100">
      <a href={`/projects/${slug}/`} class="transition-colors hover:text-[var(--accent)]">{name}</a>
    </h3>
    <p class:list={['mt-1 text-sm text-zinc-400', compact && 'line-clamp-2']}>{tagline}</p>
    <p class:list={['mt-3 text-sm leading-relaxed text-zinc-500', compact && 'line-clamp-4']}>
      {description}
    </p>

    <div class="mt-4 flex flex-wrap gap-2">
      {
        tags.map((t) => (
          <span class="rounded-full border px-2.5 py-0.5 font-mono text-[10px]" style={`border-color:${accent}44;color:${accent}`}>
            {t}
          </span>
        ))
      }
    </div>

    <div
      class:list={['flex items-center gap-3 border-t border-zinc-800/80 pt-4', compact ? 'mt-auto' : 'mt-5']}
    >
      <a
        href={`/projects/${slug}/`}
        class="rounded-md border border-zinc-700 bg-zinc-900 px-3.5 py-1.5 text-sm font-medium text-zinc-100 transition-all hover:border-[var(--accent)] hover:text-[var(--accent)]"
      >
        ▶ {playLabel}
      </a>
      <a
        href={sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-sm text-zinc-500 transition-colors hover:text-zinc-200"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
        </svg>
        {sourceLabel}
      </a>
    </div>
  </div>
</article>
