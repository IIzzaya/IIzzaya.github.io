---
/** 首页：Hero 名字轮换 + 最新文章 + 精选项目 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter from '../components/TypeWriter.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PROFILE } from '../data/profile';
import { PROJECTS } from '../data/projects';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts.slice(0, 5);
const featured = PROJECTS.filter((p) => p.featured);
// projects.ts 按从新到旧排序，过滤后顺序保持不变，最新的项目排在滚动区最左侧
---

<BaseLayout>
  <!-- Hero -->
  <section class="py-16 sm:py-24">
    <p class="font-mono text-sm text-zinc-500">// 你好，欢迎来到我的自留地</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-zinc-100 sm:text-5xl">
      Hi, I'm <TypeWriter />
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">{PROFILE.tagline}</p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href="/projects/"
        class="glow-box rounded-md border border-terminal/50 bg-terminal/10 px-5 py-2.5 font-medium text-terminal transition-colors hover:bg-terminal/20"
      >
        浏览项目画廊
      </a>
      <a
        href="/blog/"
        class="rounded-md border border-zinc-700 px-5 py-2.5 font-medium text-zinc-300 transition-colors hover:border-zinc-500 hover:text-zinc-100"
      >
        阅读博客
      </a>
      <span class="hidden items-center gap-1.5 font-mono text-xs text-zinc-600 sm:flex">
        按
        <kbd class="rounded border border-zinc-700 bg-zinc-900 px-1.5 py-0.5 text-zinc-400">Ctrl</kbd>
        +
        <kbd class="rounded border border-zinc-700 bg-zinc-900 px-1.5 py-0.5 text-zinc-400">K</kbd>
        快速跳转
      </span>
    </div>
  </section>

  <!-- 精选项目：固定尺寸卡片横向滚动，最新项目在最左 -->
  <section class="pb-6">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-xl font-semibold text-zinc-100"><span class="font-mono text-terminal">$</span> 精选项目</h2>
      <div class="flex items-center gap-4">
        <div class="hidden items-center gap-2 sm:flex">
          <button
            type="button"
            data-featured-prev
            aria-label="向前滚动精选项目"
            class="flex h-8 w-8 items-center justify-center rounded-md border border-zinc-700 text-zinc-400 transition-colors hover:border-terminal/60 hover:text-terminal disabled:pointer-events-none disabled:opacity-30"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
          <button
            type="button"
            data-featured-next
            aria-label="向后滚动精选项目"
            class="flex h-8 w-8 items-center justify-center rounded-md border border-zinc-700 text-zinc-400 transition-colors hover:border-terminal/60 hover:text-terminal disabled:pointer-events-none disabled:opacity-30"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        </div>
        <a href="/projects/" class="text-sm text-zinc-500 transition-colors hover:text-terminal">全部项目 →</a>
      </div>
    </div>

    <div
      id="featured-scroller"
      role="region"
      aria-label="精选项目，可左右滚动浏览"
      tabindex="0"
      class="featured-scroller -mx-4 mt-6 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-px-4 px-4 pb-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-terminal/40 sm:-mx-6 sm:scroll-px-6 sm:px-6 xl:-mx-16 xl:scroll-px-16 xl:px-16"
    >
      {featured.map((p) => <ProjectCard compact {...p} playLabel="Play" sourceLabel="Source Code" />)}
    </div>

    <!-- 自定义滚动指示条：与卡片内容区等宽（base/sm 抵消主栏 padding；xl 卡片静止位即栏缘，无需内缩），悬停/滚动/拖动时淡入；
         h-8 的透明命中区配合 -mt-1 保持视觉轨道位置不变（命中区为视觉轨道的 2 倍高，便于点击与拖拽） -->
    <div
      data-featured-scrollbar
      aria-hidden="true"
      class="featured-scrollbar -mt-1 mx-4 flex h-8 items-center sm:mx-6 xl:mx-0"
    >
      <div data-featured-scrollbar-track class="relative h-[3px] w-full cursor-pointer rounded-full bg-zinc-800/70">
        <div
          data-featured-scrollbar-thumb
          class="absolute inset-y-0 left-0 rounded-full bg-terminal/50 shadow-[0_0_10px_rgba(74,222,128,0.3)]"
        >
        </div>
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="pt-10">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-semibold text-zinc-100"><span class="font-mono text-terminal">$</span> 最近更新</h2>
      <a href="/blog/" class="text-sm text-zinc-500 transition-colors hover:text-terminal">全部文章 →</a>
    </div>
    <div class="mt-2">
      {
        latest.map((post) => (
          <PostCard
            title={post.data.title}
            href={`/blog/${post.id}/`}
            date={post.data.pubDate}
            tags={post.data.tags}
            description={post.data.description}
          />
        ))
      }
    </div>
  </section>

  <style>
    /* 原生滚动条隐藏（避免常驻且比卡片区宽），改用下方自定义指示条 */
    .featured-scroller {
      scrollbar-width: none;
      /* 不变量：渐隐宽度必须小于各断点的边缘留白（移动 16px / sm 24px / xl 64px），
         渐隐只会盖到被裁切的露边卡片，静止完整卡片的边框永远不被遮挡 */
      -webkit-mask-image: linear-gradient(to right, transparent, #000 12px, #000 calc(100% - 12px), transparent);
      mask-image: linear-gradient(to right, transparent, #000 12px, #000 calc(100% - 12px), transparent);
    }
    .featured-scroller::-webkit-scrollbar {
      display: none;
    }
    /* xl 留白放大到 64px（-mx-16 px-16），渐隐可相应加宽、更明显 */
    @media (min-width: 80rem) {
      .featured-scroller {
        -webkit-mask-image: linear-gradient(to right, transparent, #000 20px, #000 calc(100% - 20px), transparent);
        mask-image: linear-gradient(to right, transparent, #000 20px, #000 calc(100% - 20px), transparent);
      }
    }
    /* 自定义指示条：默认隐藏，鼠标靠近卡片 / 滚动中 / 拖动时淡入 */
    .featured-scrollbar {
      opacity: 0;
      transition: opacity 0.25s ease;
      user-select: none;
      touch-action: none;
    }
    .featured-scrollbar.is-active,
    .featured-scrollbar:hover {
      opacity: 1;
    }
    /* 拖拽指示条期间临时关闭卡片吸附，避免浏览器吸附与拖拽互相打架（松手后由脚本平滑吸附归位） */
    .featured-scroller.is-bar-dragging {
      scroll-snap-type: none;
    }
    .featured-scrollbar.is-dragging,
    .featured-scrollbar.is-dragging [data-featured-scrollbar-track] {
      cursor: grabbing;
    }
    .featured-scrollbar.is-dragging [data-featured-scrollbar-thumb] {
      background: var(--color-terminal);
    }
    .featured-scroller::-webkit-scrollbar {
      height: 6px;
    }
    .featured-scroller::-webkit-scrollbar-track {
      background: transparent;
    }
    .featured-scroller::-webkit-scrollbar-thumb {
      border-radius: 9999px;
      background: var(--color-zinc-700);
    }
    .featured-scroller:hover::-webkit-scrollbar-thumb {
      background: color-mix(in srgb, var(--color-terminal) 35%, transparent);
    }
  </style>

  <script>
    /** 精选项目横向滚动：左右箭头按卡翻页 + 自定义滚动指示条（悬停/滚动时显示，可点击跳转与拖拽） */
    const scroller = document.getElementById('featured-scroller');
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-featured-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-featured-next]');
    const bar = document.querySelector<HTMLElement>('[data-featured-scrollbar]');
    const track = document.querySelector<HTMLElement>('[data-featured-scrollbar-track]');
    const thumb = document.querySelector<HTMLElement>('[data-featured-scrollbar-thumb]');

    if (scroller && prevBtn && nextBtn) {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const behavior: ScrollBehavior = reduced ? 'auto' : 'smooth';

      // 一次滚动一张卡片（卡宽 + gap-5 的 20px 间距）
      const step = () => {
        const card = scroller.querySelector<HTMLElement>('article');
        return card ? card.offsetWidth + 20 : 340;
      };
      const maxScroll = () => scroller.scrollWidth - scroller.clientWidth;

      // ---- 指示条显隐：悬停或近期滚动时保持可见，静止后淡出 ----
      let hovering = false;
      let dragging = false;
      let hideTimer: number | undefined;
      const showBar = () => {
        bar?.classList.add('is-active');
        if (hideTimer !== undefined) window.clearTimeout(hideTimer);
      };
      const scheduleHide = () => {
        if (hideTimer !== undefined) window.clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => {
          if (!hovering && !dragging) bar?.classList.remove('is-active');
        }, 900);
      };

      const update = () => {
        const range = maxScroll();
        prevBtn.disabled = scroller.scrollLeft <= 4;
        nextBtn.disabled = scroller.scrollLeft >= range - 4;
        if (bar && thumb) {
          const scrollable = range > 4;
          bar.classList.toggle('hidden', !scrollable);
          // 滑块宽度 = 可视占比（最小 8% 保证可点抓）；行程按剩余宽度等比映射
          const widthPct = Math.max((scroller.clientWidth / scroller.scrollWidth) * 100, 8);
          const progress = range > 0 ? scroller.scrollLeft / range : 0;
          thumb.style.width = `${widthPct}%`;
          thumb.style.left = `${progress * (100 - widthPct)}%`;
        }
      };

      prevBtn.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior }));
      nextBtn.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior }));

      scroller.addEventListener('pointerenter', () => {
        hovering = true;
        showBar();
      });
      scroller.addEventListener('pointerleave', () => {
        hovering = false;
        scheduleHide();
      });
      scroller.addEventListener('scroll', () => {
        update();
        showBar();
        scheduleHide();
      }, { passive: true });
      window.addEventListener('resize', update);
      update();

      // ---- 指示条交互：点击跳转 + 拖拽滑动（拖拽期间关闭吸附，松手平滑归位到最近卡片） ----
      if (track && thumb) {
        const widthPct = () => Math.max((scroller.clientWidth / scroller.scrollWidth) * 100, 8);
        const clamp01 = (v: number) => Math.min(Math.max(v, 0), 1);
        let dragPct = 8;
        let dragStartX = 0;
        let dragStartScroll = 0;
        let rafId: number | undefined;
        let snapTimer: number | undefined;

        const applyScroll = (clientX: number) => {
          // 每帧重取轨道 rect；滑块位置与指针严格 1:1
          const rect = track.getBoundingClientRect();
          const delta = ((clientX - dragStartX) / (rect.width * (1 - dragPct / 100))) * maxScroll();
          scroller.scrollLeft = clamp01((dragStartScroll + delta) / maxScroll()) * maxScroll();
        };

        const endDrag = () => {
          if (!dragging) return;
          dragging = false;
          bar?.classList.remove('is-dragging');
          if (rafId !== undefined) {
            window.cancelAnimationFrame(rafId);
            rafId = undefined;
          }
          // 松手：平滑吸附到最近的卡片吸附位（与 scroll-snap 的落点一致）
          const nearest = Math.round(scroller.scrollLeft / step()) * step();
          const target = Math.min(Math.max(nearest, 0), maxScroll());
          scroller.scrollBy({ left: target - scroller.scrollLeft, behavior });
          // 吸附动画结束后再恢复原生 snap，避免中途打断
          if (snapTimer !== undefined) window.clearTimeout(snapTimer);
          snapTimer = window.setTimeout(() => {
            scroller.classList.remove('is-bar-dragging');
            snapTimer = undefined;
          }, 700);
          scheduleHide();
        };

        track.addEventListener('pointerdown', (e) => {
          if (maxScroll() <= 0) return;
          if (snapTimer !== undefined) {
            window.clearTimeout(snapTimer);
            snapTimer = undefined;
          }
          scroller.classList.add('is-bar-dragging');
          dragging = true;
          bar?.classList.add('is-dragging');
          try {
            track.setPointerCapture(e.pointerId);
          } catch {
            /* 合成事件等无活动指针场景下捕获失败可忽略 */
          }
          // 滑块中心先跳到点击处（与原生滚动条一致），随后相对该点拖拽
          const rect = track.getBoundingClientRect();
          dragPct = widthPct();
          const target = clamp01(((e.clientX - rect.left) / rect.width - dragPct / 200) / (1 - dragPct / 100));
          scroller.scrollLeft = target * maxScroll();
          dragStartX = e.clientX;
          dragStartScroll = scroller.scrollLeft;
          showBar();
          e.preventDefault();
        });
        track.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          // rAF 合帧：一帧最多写一次 scrollLeft
          if (rafId !== undefined) window.cancelAnimationFrame(rafId);
          const x = e.clientX;
          rafId = window.requestAnimationFrame(() => {
            rafId = undefined;
            applyScroll(x);
          });
        });
        track.addEventListener('pointerup', endDrag);
        track.addEventListener('pointercancel', endDrag);
        track.addEventListener('lostpointercapture', endDrag);
      }
    }
  </script>
</BaseLayout>
