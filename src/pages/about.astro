---
/** 关于页（内容来自 profile.ts 占位骨架） */
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE } from '../data/profile';
import { SITE } from '../data/site';

const { about } = PROFILE;
/** 极简 **bold** 渲染（输入是本地受控配置，安全） */
const rich = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong class="text-zinc-100">$1</strong>');
---

<BaseLayout title="关于" description={`关于 ${SITE.author}。`}>
  <section class="py-12">
    <h1 class="text-3xl font-bold text-zinc-100"><span class="font-mono text-terminal glow-text">$</span> whoami</h1>

    <div class="mt-8 space-y-4 text-lg leading-relaxed text-zinc-300">
      {about.intro.map((p) => <p set:html={rich(p)} />)}
    </div>

    <h2 class="mt-12 text-xl font-semibold text-zinc-100"><span class="font-mono text-terminal">$</span> 兴趣与技能</h2>
    <div class="mt-4 flex flex-wrap gap-2.5">
      {
        about.interests.map((it) => (
          <span class="rounded-md border border-zinc-800 bg-zinc-900/40 px-3 py-1.5 text-sm text-zinc-400">
            {it}
          </span>
        ))
      }
    </div>

    <h2 class="mt-12 text-xl font-semibold text-zinc-100"><span class="font-mono text-terminal">$</span> 足迹</h2>
    <ol class="mt-4 space-y-4 border-l border-zinc-800 pl-5">
      {
        about.timeline.map((t) => (
          <li class="relative">
            <span class="absolute -left-[26.5px] top-1.5 h-2.5 w-2.5 rounded-full border border-terminal/60 bg-zinc-950" aria-hidden="true" />
            <span class="font-mono text-sm text-terminal">{t.year}</span>
            <p class="mt-1 text-sm leading-relaxed text-zinc-400">{t.text}</p>
          </li>
        ))
      }
    </ol>

    <h2 class="mt-12 text-xl font-semibold text-zinc-100"><span class="font-mono text-terminal">$</span> 联系</h2>
    <p class="mt-4 text-zinc-400">{about.contact}</p>
    <div class="mt-4 flex gap-3">
      {
        PROFILE.social.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md border border-zinc-700 px-4 py-2 text-sm text-zinc-300 transition-colors hover:border-terminal hover:text-terminal"
          >
            {s.name} ↗
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
