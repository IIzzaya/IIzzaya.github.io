---
/** 404：终端风 command not found */
import BaseLayout from '../layouts/BaseLayout.astro';
const tried = Astro.url.pathname;
---

<BaseLayout title="404" description="页面不存在。">
  <section class="py-24">
    <div class="mx-auto max-w-xl rounded-xl border border-zinc-800 bg-zinc-900/40 p-6 font-mono text-sm sm:p-8">
      <p class="text-zinc-500"><span class="text-terminal">iizzaya@github</span>:<span class="text-sky-400">~</span>$ cat {tried}</p>
      <p class="mt-3 text-red-400">cat: {tried}: No such file or directory</p>
      <p class="mt-3 text-zinc-500"><span class="text-terminal">iizzaya@github</span>:<span class="text-sky-400">~</span>$ <span class="ml-1 inline-block h-4 w-[9px] translate-y-[3px] bg-terminal animate-cursor-blink" aria-hidden="true"></span></p>
      <p class="mt-6 text-zinc-400">你要找的页面不存在（或从未存在过）。</p>
      <div class="mt-6 flex gap-3">
        <a href="/" class="rounded-md border border-terminal/50 bg-terminal/10 px-4 py-2 text-zinc-100 transition-colors hover:bg-terminal/20"><span class="text-terminal">cd</span> ~/</a>
        <a href="/blog/" class="rounded-md border border-zinc-700 px-4 py-2 text-zinc-300 transition-colors hover:border-zinc-500"><span class="font-mono text-terminal">cd</span> ~/blog</a>
      </div>
    </div>
  </section>
</BaseLayout>
