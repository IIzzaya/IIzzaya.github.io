---
/**
 * 项目嵌入路由：/projects/<slug>/
 * 全屏 iframe 加载子项目自身的 Pages 产物（同域名子路径），顶栏保留轻量导航。
 */
import '../../../styles/global.css';
import { PROJECTS } from '../../../data/projects';
import { SITE } from '../../../data/site';

export function getStaticPaths() {
  return PROJECTS.filter((p) => p.embed).map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const embedSrc = `/${project.repo}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{project.name} · {SITE.title}</title>
    <meta name="description" content={project.tagline} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex h-screen flex-col overflow-hidden bg-zinc-950 font-sans text-zinc-100 antialiased">
    <!-- 轻量顶栏 -->
    <div class="flex items-center justify-between gap-3 border-b border-zinc-800 bg-zinc-950/90 px-3 py-2 sm:px-5">
      <div class="flex min-w-0 items-center gap-3">
        <a href="/projects/" class="shrink-0 rounded-md border border-zinc-700 px-2.5 py-1 font-mono text-xs text-zinc-400 transition-colors hover:border-terminal hover:text-terminal" title="返回画廊">
          ← cd ..
        </a>
        <h1 class="truncate text-sm font-medium text-zinc-200">{project.name}</h1>
        <span class="hidden truncate text-xs text-zinc-600 md:block">{project.tagline}</span>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <a
          href={project.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden rounded-md border border-zinc-700 px-2.5 py-1 text-xs text-zinc-400 transition-colors hover:border-zinc-500 hover:text-zinc-200 sm:block"
        >
          查看源码
        </a>
        <a
          href={embedSrc}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md border border-terminal/50 bg-terminal/10 px-2.5 py-1 text-xs font-medium text-terminal transition-colors hover:bg-terminal/20"
        >
          新窗口打开 ↗
        </a>
      </div>
    </div>

    <!-- 全屏嵌入 -->
    <iframe
      src={embedSrc}
      title={project.name}
      class="w-full flex-1 border-0 bg-black"
      allow="fullscreen; gamepad; autoplay"
      allowfullscreen
    ></iframe>

    <noscript>
      <p class="p-4 text-sm text-zinc-400">
        此页面需要浏览器支持 iframe。也可以直接访问 <a class="text-terminal underline" href={embedSrc}>{project.repo} 独立页面</a>。
      </p>
    </noscript>
  </body>
</html>
